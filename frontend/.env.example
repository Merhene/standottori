# Supabase project credentials
# Found in: Supabase Dashboard > Project Settings > API
# Copy this file to .env.local and fill in the values (never commit .env.local)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# MapTiler Cloud — required for the public Events map (MapLibre + MapTiler styles)
# Create a key at https://cloud.maptiler.com/account/keys/
# Restrict by HTTP referrer: localhost:*, https://standottori.com/*, https://*.vercel.app/*
# Use a browser / public key only — never a secret server key.
VITE_MAPTILER_API_KEY=
